# ==============================================================================
# 🌐 GreenCard — Central API Gateway Template (.env.example)
# ==============================================================================
NODE_ENV=production
PORT=5000
GATEWAY_PORT=5000

# Microservice Render Production URLs
USER_SERVICE_URL=https://greencards-user-backend-yevd.onrender.com
SELLER_SERVICE_URL=https://greencards-seller-backend-2uh2.onrender.com
ADMIN_SERVICE_URL=https://greencards-admin-backend-wnzg.onrender.com
SUPERADMIN_SERVICE_URL=https://greencards-superadmin-backend-x8q0.onrender.com

# CORS — comma-separated list of allowed frontend origins.
# Add every GitHub Pages / custom domain that needs to call the API.
# Without this set correctly on Render, the real frontend will be blocked by CORS.
FRONTEND_ORIGINS=https://akash520820.github.io,http://localhost:5173,http://localhost:3000
